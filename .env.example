# Copy to .env and adjust. docker-compose.yml reads this file.

# Password of the project's Postgres. Required.
FLOW_DB_PASSWORD=change-this-password

# Fallback label for flow_versions.author. Only used when a save arrives through
# a share link (no account); with a signed-in user, their name wins.
FLOW_AUTHOR=

# Size ceiling for attachments uploaded to the API, in MB.
FLOW_MAX_UPLOAD_MB=10

# ── Where lineOS listens ─────────────────────────────────────────────

# Interface and port of the published frontend. 127.0.0.1 keeps it local (put a
# reverse proxy with HTTPS in front); a private IP exposes it on that network.
FLOW_BIND_IP=127.0.0.1
FLOW_HTTP_PORT=8020

# The subpath the app is served from: "/" at the root of a host, or e.g.
# "/lineos/" when a proxy shares the host with other apps. Fixed at build time:
# change it, then `docker compose up -d --build frontend`.
FLOW_BASE=/

# Loopback ports of the API (for `npm run dev`) and of Postgres (for the
# collector, see ops/README.md).
FLOW_API_PORT=8010
FLOW_DB_PORT=5433

# ── Accounts and sharing ─────────────────────────────────────────────

# Who may sign up after the first account (which is always allowed and becomes
# the admin): open (anyone), invite (only someone holding a live share link) or
# closed (nobody).
FLOW_REGISTRATION=invite

# Public address of the app, used to build the link in the body of the sharing
# email. The browser builds its own; the server needs this one.
FLOW_PUBLIC_BASE_URL=http://localhost:8020/

# A Secure cookie is never sent over plain HTTP, so this stays false until the
# app is reached over HTTPS only. Then turn it on.
FLOW_SESSION_COOKIE_SECURE=false

# Session lifetime in days (the cookie and the user_sessions row).
FLOW_SESSION_DAYS=30

# ── SMTP (optional) ──────────────────────────────────────────────────
# Without SMTP_HOST, "Send by email" in the Share menu still works: instead of
# the server sending it, the editor opens the user's own mail client with the
# link ready. Fill this in to have the server send it.
FLOW_SMTP_HOST=
FLOW_SMTP_PORT=587
FLOW_SMTP_USER=
FLOW_SMTP_PASSWORD=
FLOW_SMTP_STARTTLS=true
FLOW_SMTP_FROM=

# ── Data Lineage: dataset source (optional) ──────────────────────────
# Only read with docker-compose.lineage.yml layered on the base file. The
# Postgres whose tables the lineages observe, reached read-only.
LINEAGE_SOURCE_NETWORK=
LINEAGE_SOURCE_HOST=
LINEAGE_SOURCE_PORT=5432
LINEAGE_SOURCE_DB=
LINEAGE_SOURCE_USER=
LINEAGE_SOURCE_PASSWORD_FILE=./secrets/lineage_source_password
# The column "latest rows" sorts by when a binding names none. Empty = the
# table's primary key.
LINEAGE_SOURCE_ORDER_COLUMN=

# ── MCP (backend/mcp) ────────────────────────────────────────────────
# The MCP server reads these from here -- the MCP client starts the process with
# whatever environment it has, so exporting in a shell would not reach it. Only
# FLOW_MCP_* keys are read from this file; a real environment variable wins over
# them. Without an email and password the server still starts, but every tool
# that talks to the API answers "no credentials configured".
FLOW_MCP_BASE_URL=http://127.0.0.1:8010
FLOW_MCP_EMAIL=
FLOW_MCP_PASSWORD=

# Set to "true" to expose only the reading tools (the agent opens and exports,
# but writes no version and deletes no flow).
FLOW_MCP_READ_ONLY=false
