# Copy to .env and adjust. docker-compose.yml reads this file.

# Password of the project's Postgres (container flow-postgres). Required.
FLOW_DB_PASSWORD=change-this-password

# Fallback label for flow_versions.author. Only used when a save arrives through
# a share link (no account); with a signed-in user, their name wins.
FLOW_AUTHOR=

# Size ceiling for attachments uploaded to the API, in MB.
FLOW_MAX_UPLOAD_MB=10

# Interface the published frontend listens on for port 8020. Use the Tailscale
# IP to expose it on the tailnet only; 127.0.0.1 to keep it local.
FLOW_BIND_IP=100.64.0.10

# ── Accounts and sharing ─────────────────────────────────────────────

# Public address of the SPA, used to build the link in the body of the sharing
# email. The browser builds its own; the server needs this one.
FLOW_PUBLIC_BASE_URL=https://lineos.example.com/flow-editor/

# Deliberately "false" even with public access over HTTPS: the tailnet reaches
# the application over HTTP (http://100.64.0.10/flow-editor/), and with Secure
# on, the browser would not send the cookie there -- internal sign-in would
# break. Turn it on once HTTP access is gone.
FLOW_SESSION_COOKIE_SECURE=false

# Session lifetime in days (the cookie and the user_sessions row).
FLOW_SESSION_DAYS=30

# ── SMTP (optional) ──────────────────────────────────────────────────
# Without SMTP_HOST, "Send by email" in the Share menu still works: instead of
# the server sending it, the editor opens the user's own mail client with the
# link ready. Fill this in to have the server send it.
FLOW_SMTP_HOST=
FLOW_SMTP_PORT=587
FLOW_SMTP_USER=
FLOW_SMTP_PASSWORD=
FLOW_SMTP_STARTTLS=true
FLOW_SMTP_FROM=

# ── MCP (backend/mcp) ────────────────────────────────────────────────
# The MCP server reads these from here -- the MCP client starts the process with
# whatever environment it has, so exporting in a shell would not reach it. Only
# FLOW_MCP_* keys are read from this file; a real environment variable wins over
# them. Without an email and password the server still starts, but every tool
# that talks to the API answers "no credentials configured".
FLOW_MCP_BASE_URL=http://127.0.0.1:8010
FLOW_MCP_EMAIL=
FLOW_MCP_PASSWORD=

# Set to "true" to expose only the reading tools (the agent opens and exports,
# but writes no version and deletes no flow).
FLOW_MCP_READ_ONLY=false
