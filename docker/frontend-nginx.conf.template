# The frontend container's nginx. Serves the SPA at ${LINEOS_BASE} and forwards
# ${LINEOS_PREFIX}/api/ to the API container. The image's entrypoint fills the
# LINEOS_* variables (see lineos-base.envsh) and writes the result to
# /etc/nginx/conf.d/default.conf; nginx's own $variables are left alone.

# Credential routes (sign-in, sign-up, password change): 10 attempts a minute
# per client address, with a small burst. Behind a reverse proxy every client
# shares the proxy's address -- rate-limit there instead, or add real_ip.
limit_req_zone $binary_remote_addr zone=lineos_auth:10m rate=10r/m;

server {
  listen 80;
  server_name _;
  # Relative redirects: with absolute_redirect on, nginx builds http://$host/...
  # and loses both the published port and a proxy's scheme.
  absolute_redirect off;
  # Docker DNS: the variable in proxy_pass forces re-resolution when the API
  # container restarts on a new IP.
  resolver 127.0.0.11 valid=10s;

  # Same proxy as below, throttled: the API itself has no rate limit, so this
  # is what keeps a brute force off the passwords. The SPA shows a 429 as
  # "too many attempts".
  location ${LINEOS_PREFIX}/api/auth/ {
    limit_req zone=lineos_auth burst=5 nodelay;
    limit_req_status 429;
    set $api_upstream http://api:8000;
    rewrite ^${LINEOS_PREFIX}(/api/.*)$ $1 break;
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # API -> FastAPI. The subpath prefix is stripped; the API exposes /api/*.
  location ${LINEOS_PREFIX}/api/ {
    # The compose SERVICE name, not a container_name: `api` resolves in any
    # stack of this project, whatever it is called.
    set $api_upstream http://api:8000;
    rewrite ^${LINEOS_PREFIX}(/api/.*)$ $1 break;
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Room for the API's 10 MB per-attachment ceiling.
    client_max_body_size 12m;
    proxy_read_timeout 120s;
  }

  # Hashed bundles: immutable cache.
  location ${LINEOS_PREFIX}/assets/ {
    root /usr/share/nginx/html;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # SPA: every route falls through to index.html.
  location ${LINEOS_BASE} {
    root /usr/share/nginx/html;
    try_files $uri $uri/ ${LINEOS_BASE}index.html;
    add_header Cache-Control "no-cache" always;
  }

  ${LINEOS_REDIRECTS}

  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }
}
